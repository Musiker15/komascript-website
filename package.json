{
  "name": "komascript-homepage",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio-Projekt: Webpräsenz rund um KOMA-Script von Markus Kohm, die vielseitigen LaTeX-Klassen und Pakete. Kein offizieller Auftritt.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "Moritz Kohm",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.28.8",
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build --turbopack",
    "start": "next start -p 3000",
    "start:e2e": "next start -p 3218",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx,css}\"",
    "validate:content": "tsx scripts/validate-content.ts",
    "build:search": "tsx scripts/build-search-index.ts",
    "test": "vitest --passWithNoTests",
    "test:e2e": "playwright test",
    "prebuild": "pnpm run validate:content && pnpm run build:search"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "next-mdx-remote": "^6.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "gray-matter": "^4.0.3",
    "zod": "^4.6.7",
    "lucide-react": "^1.61.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "shiki": "^4.5.0",
    "flexsearch": "^0.8.212",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "get-nonce": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/mdx": "^2.0.14",
    "typescript": "^6.0.3",
    "eslint": "^10.13.0",
    "typescript-eslint": "^8.72.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5",
    "@playwright/test": "^1.64.1"
  }
}
